# PostgreSQL (Neon). Agrega ?sslmode=require al final.
DATABASE_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/emprendeflow?sslmode=require"

# Secretos JWT (usa cadenas largas y aleatorias en producción)
JWT_ACCESS_SECRET="cambia-este-secreto-de-acceso-por-uno-largo-y-aleatorio"
JWT_REFRESH_SECRET="cambia-este-secreto-de-refresh-por-uno-largo-y-aleatorio"

PORT=4000
NODE_ENV=development

# Duración de los tokens (opcional)
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Orígenes permitidos del frontend, separados por coma
CLIENT_ORIGIN="http://localhost:5173"

# Cookies: en producción con dominios distintos (Vercel + API) usa
# COOKIE_SAMESITE=none y COOKIE_SECURE=true
COOKIE_SAMESITE="lax"
COOKIE_SECURE=false

# Vercel Blob: almacenamiento persistente de fotos de productos y comprobantes.
# Créalo en Vercel > Storage > Blob con acceso Private y copia el token.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx"

# Opcional: solo para servir imágenes locales antiguas.
# UPLOAD_DIR="C:/ruta/persistente/uploads"
